PORT=3013
SNOWFLAKE_ACCOUNT=<account identifier>
SNOWFLAKE_USER=<user>
SNOWFLAKE_PRIVATE_KEY_PATH=<path to .p8 key>
SNOWFLAKE_ROLE=<role with access to MFG_SPEND_RISK>
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MFG_SPEND_RISK
SNOWFLAKE_SCHEMA=GOLD
CORTEX_MODEL=claude-sonnet-4-5
# Optional: override where the dbt project and binary live
# DBT_PROJECT_DIR=../dbt
# DBT_BIN=../../../.venv/bin/dbt
# Where Apply on the Data Sources page runs dbt: local (dbt CLI) or snowflake (EXECUTE DBT PROJECT)
DBT_EXECUTION=local
# DBT_PROJECT_OBJECT=MFG_SPEND_RISK.CONFIG.MULTI_ERP_SPEND_DBT
